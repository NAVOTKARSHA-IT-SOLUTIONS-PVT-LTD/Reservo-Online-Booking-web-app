# Database Configuration
# For MySQL production: jdbc:mysql://localhost:3306/reservo_db
# For H2 development: jdbc:h2:mem:reservodb;DB_CLOSE_DELAY=-1;MODE=MySQL
DATABASE_URL=jdbc:h2:mem:reservodb;DB_CLOSE_DELAY=-1;MODE=MySQL
DATABASE_DRIVER=org.h2.Driver
DATABASE_USERNAME=sa
DATABASE_PASSWORD=reservo_secure_h2_pass
DATABASE_DIALECT=org.hibernate.dialect.H2Dialect

# JWT Configuration (WARNING: Use strong random secret in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRATION_MS=86400000

# Email Configuration (Optional - leave empty to disable email features)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# H2 Console (set to true only for development)
H2_CONSOLE_ENABLED=false

# OAuth2 Configuration (Optional - leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# OTP Configuration
OTP_EXPIRATION_MINUTES=5
